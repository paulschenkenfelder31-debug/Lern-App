rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    match /users/{uid}/settings/current {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 100000;
    }
    match /users/{uid}/bookmarks/current {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 100000;
    }
    match /users/{uid}/sessions/{sessionId} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['json', 'updatedAt'])
        && request.resource.data.json is string
        && request.resource.data.json.size() < 900000;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
